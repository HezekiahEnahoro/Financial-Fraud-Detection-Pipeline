# ── Fraud DB (postgres-fraud) ──────────────────────────────────────────────
POSTGRES_USER=fraud
POSTGRES_PASSWORD=change_me
POSTGRES_DB=fraud_db
POSTGRES_HOST=postgres-fraud
POSTGRES_PORT=5432

# ── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_TOPIC=transactions

# ── Pipeline ────────────────────────────────────────────────────────────────
DEAD_LETTER_DIR=/opt/airflow/dead_letter

# ── Airflow metadata DB (postgres-airflow) ──────────────────────────────────
AIRFLOW_DB_PASSWORD=change_me

# ── Airflow security ────────────────────────────────────────────────────────
# Generate Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Generate secret key: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# ── Airflow admin user (created on first init) ───────────────────────────────
AIRFLOW_ADMIN_PASSWORD=change_me

# ── Grafana ─────────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=change_me

# ── Alerting (optional) ─────────────────────────────────────────────────────
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
